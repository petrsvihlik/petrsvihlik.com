<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <DefaultItemExcludes>$(DefaultItemExcludes);output\**</DefaultItemExcludes>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Statiq.Web" Version="1.0.0-beta.60" />
  </ItemGroup>

  <!-- Vulnerability overrides for transitive dependencies -->
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.11" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <!--
    Microsoft.Rest.ClientRuntime is deprecated (no drop-in replacement) and is intentionally
    NOT referenced directly. It only enters the graph via Statiq.Web -> Statiq.Web.Azure ->
    Microsoft.Azure.Search deploy modules, which this site never invokes (deployment is done
    by GitHub Actions), so the advisory below (Authorization header disclosure in ClientRuntime's
    HTTP retry logging) concerns code that never executes here.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-whph-446h-6m9v" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="input\**" />
    <None Include="input\**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    NOTE: the extension-method folder is named "MyExtensions" because Statiq.Web's MSBuild
    targets remove `extensions/**` from compilation (the folder is reserved for Statiq's
    runtime script extensions), so a folder named "Extensions" would be silently excluded.
  -->

</Project>
