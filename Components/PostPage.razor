@using System.Globalization
<SiteLayout Ctx="Ctx" Seo="Seo" PageType="post" ActiveNav="articles" IncludeHighlight="Highlight">
    <ChildContent>
<main class="wrap">

    <div class="sec-head" style="margin-top:46px">
        <h2><span class="sym">$</span> cat @(Article.Slug).md</h2>
        @if (Article.PublishDate != null)
        {
            <span class="count">@Article.PublishDate?.ToString("yyyy-MM", CultureInfo.InvariantCulture.DateTimeFormat)@(Article.Updated != null ? $" · upd {Article.Updated?.ToString("yyyy-MM", CultureInfo.InvariantCulture.DateTimeFormat)}" : "")</span>
        }
    </div>
    <hr class="sep">

    <article class="article-single" style="margin-top:24px">
<PostArticle Ctx="Ctx" Article="Article" />
    </article>

    <Newsletter Source="post" />

    @if (Article.Comments)
    {
        <Comments Term="@($"posts/{Article.Slug}")" />
    }

</main>
    </ChildContent>
</SiteLayout>

@code {
    [Parameter] public PageContext Ctx { get; set; }
    [Parameter] public PageSeo Seo { get; set; }
    [Parameter] public Article Article { get; set; }
    [Parameter] public bool Highlight { get; set; }
}
